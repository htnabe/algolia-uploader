{
  "name": "algolia-uploader",
  "version": "0.0.14",
  "description": "command-line util to upload Algolia source",
  "repository": {
    "type": "git",
    "url": "https://github.com/htnabe/algolia-uploader.git"
  },
  "type": "module",
  "bin": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.1"
  },
  "dependencies": {
    "algoliasearch": "^5.52.1",
    "citty": "^0.2.2",
    "es-toolkit": "^1.46.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@dotenvx/dotenvx": "^1.66.0",
    "@types/node": "^25.9.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.5",
    "npm-check-updates": "^22.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "unrun": "^0.3.0",
    "vitest": "^4.1.6"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "prepare": "node .husky/install.mjs",
    "lint": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "dotenvx run jiti ./src/index.ts",
    "update": "ncu --upgrade && npm install"
  },
  "keywords": [
    "algolia"
  ],
  "author": "htnabe <https://github.com/htnabe>",
  "license": "ISC",
  "lint-staged": {
    "*.{js,ts}": [
      "biome check --write"
    ],
    "*.{json,md}": [
      "biome check --write ."
    ]
  }
}
