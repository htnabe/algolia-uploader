{
  "name": "algolia-uploader",
  "version": "0.0.19",
  "description": "command-line util to upload Algolia source",
  "repository": {
    "type": "git",
    "url": "https://github.com/htnabe/algolia-uploader.git"
  },
  "type": "module",
  "bin": {
    "algolia-uploader": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.1"
  },
  "dependencies": {
    "algoliasearch": "^5.57.0",
    "citty": "^0.2.2",
    "es-toolkit": "^1.51.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@dotenvx/dotenvx": "^2.21.0",
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "npm-check-updates": "^23.0.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "prepare": "node .husky/install.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "lint-staged",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "dotenvx run -f .env.local jiti ./src/index.ts",
    "update": "ncu --upgrade && npm install"
  },
  "keywords": [
    "algolia"
  ],
  "author": "htnabe <https://github.com/htnabe>",
  "license": "ISC",
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,json,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  }
}
