{
  "name": "algolia-uploader",
  "version": "0.0.15-beta.2",
  "description": "command-line util to upload Algolia source",
  "repository": {
    "type": "git",
    "url": "https://github.com/htnabe/algolia-uploader.git"
  },
  "type": "module",
  "bin": {
    "algolia-uploader": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.1"
  },
  "dependencies": {
    "algoliasearch": "^5.55.1",
    "citty": "^0.2.2",
    "es-toolkit": "^1.49.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@dotenvx/dotenvx": "^1.75.1",
    "@types/node": "^26.0.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.8",
    "npm-check-updates": "^22.2.8",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "prepare": "node .husky/install.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "lint-staged",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "dotenvx run jiti ./src/index.ts",
    "update": "ncu --upgrade && npm install"
  },
  "keywords": [
    "algolia"
  ],
  "author": "htnabe <https://github.com/htnabe>",
  "license": "ISC",
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,json,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "inlinedDependencies": {
    "@dotenvx/dotenvx": "1.75.1",
    "@dotenvx/primitives": "0.8.0",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "ansi-colors": "4.1.3",
    "ansi-regex": "5.0.1",
    "atomically": "1.7.0",
    "conf": "10.2.0",
    "cross-spawn": "7.0.6",
    "debounce-fn": "4.0.0",
    "dot-prop": "6.0.1",
    "dotenv": "17.2.3",
    "enquirer": "2.4.1",
    "env-paths": "2.2.1",
    "execa": "5.1.1",
    "fast-deep-equal": "3.1.3",
    "fast-uri": "3.1.2",
    "fdir": "6.5.0",
    "find-up": "3.0.0",
    "get-stream": "6.0.1",
    "human-signals": "2.1.0",
    "is-obj": "2.0.0",
    "is-stream": "2.0.1",
    "isexe": "2.0.0",
    "json-schema-traverse": "1.0.0",
    "locate-path": "3.0.0",
    "merge-stream": "2.0.0",
    "mimic-fn": [
      "2.1.0",
      "3.1.0"
    ],
    "npm-run-path": "4.0.1",
    "onetime": "5.1.2",
    "p-limit": "2.3.0",
    "p-locate": "3.0.0",
    "p-try": "2.2.0",
    "path-exists": "3.0.0",
    "path-key": "3.1.1",
    "picomatch": "4.0.4",
    "pkg-up": "3.1.0",
    "semver": "7.8.4",
    "shebang-command": "2.0.0",
    "shebang-regex": "3.0.0",
    "signal-exit": "3.0.7",
    "strip-ansi": "6.0.1",
    "strip-final-newline": "2.0.0",
    "systeminformation": "5.31.7",
    "undici": "7.28.0",
    "which": "2.0.2"
  }
}
