{
  "name": "algolia-uploader",
  "version": "0.0.20",
  "packageManager": "bun@1.4.3",
  "description": "command-line util to upload Algolia source",
  "repository": {
    "type": "git",
    "url": "https://github.com/htnabe/algolia-uploader.git"
  },
  "type": "module",
  "bin": {
    "algolia-uploader": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.1"
  },
  "dependencies": {
    "algoliasearch": "^5.59.0",
    "citty": "^0.2.2",
    "es-toolkit": "^1.52.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@dotenvx/dotenvx": "^2.34.1",
    "@types/node": "^26.6.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.0.3",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "prepare": "node .husky/install.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "lint-staged",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "JITI_TSCONFIG_PATHS=true dotenvx run -f .env.local jiti ./src/index.ts",
    "update": "ncu --upgrade && bun install"
  },
  "keywords": [
    "algolia"
  ],
  "author": "htnabe <https://github.com/htnabe>",
  "license": "ISC",
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,json,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "inlinedDependencies": {
    "@dotenvx/dotenvx": "2.34.1",
    "@dotenvx/primitives": "3.2.0",
    "@dotenvx/providers": "0.3.4",
    "@dotenvx/tooling": "1.0.4",
    "picomatch": "4.0.7",
    "yocto-spinner": "1.2.2",
    "yoctocolors": "2.1.2"
  }
}
