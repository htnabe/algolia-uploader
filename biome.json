{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "off",
        "noThisInStatic": "off"
      },
      "performance": {
        "noDelete": "off"
      },
      "suspicious": {
        "noDoubleEquals": "off"
      }
    }
  }
}
